# Public Supabase values from Project Settings → API.
# These are required for signup, login, and the rest of the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used for auth callbacks and password-reset redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true only after Google is enabled in Supabase Auth → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only. Never put this in NEXT_PUBLIC_* or client files.
SUPABASE_SERVICE_ROLE_KEY=
